# .env.example — environment template for the Media Stream AI group site.
# Never commit real values; set them in the Netlify deploy environment.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://www.mediastreamai.com

# --- MSAI sales platform (lead destination for every CTA on the site) ---
# Defaults to https://sales.mediastreamai.com/api/leads when unset.
SALES_PLATFORM_WEBHOOK=
SALES_PLATFORM_TOKEN=

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
FROM_EMAIL=noreply@mediastreamai.com
SALES_EMAIL=contact@mediastreamai.com

# --- Databases (optional sinks) ---
MONGODB_URI=
POSTGRES_URL=

# --- Stripe ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_VIEWER_PREMIUM_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_VIEWER_FAMILY_MONTHLY=

# --- Auth ---
JWT_SECRET=

# --- Lead capture files (server-side, never committed) ---
TRIAL_CSV_PATH=
SALES_CSV_PATH=
TRIAL_EXPORT_KEY=
